# Research, extraction, synthesis and evaluation use this model by default.
LLM_PROVIDER=aliyun
ALIYUN_API_KEY=your-model-studio-api-key
# DASHSCOPE_API_KEY is also accepted. Credentials must match the endpoint region.
ALIYUN_MODEL=deepseek-v4.1-flash
ALIYUN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# Workspace endpoints: replace with your real workspace ID and region.
# ALIYUN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ALIYUN_BASE_URL=https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
THINKING_ENABLED=true
REASONING_EFFORT=max
# Caps may lower documented model limits; they cannot raise them.
CONTEXT_TOKENS=1000000
MODEL_OUTPUT_TOKENS=393216
PLANNER_INPUT_TOKENS=24000
PLANNER_OUTPUT_TOKENS=16384
RESEARCHER_INPUT_TOKENS=24000
RESEARCHER_OUTPUT_TOKENS=16384
WRITER_INPUT_TOKENS=64000
WRITER_OUTPUT_TOKENS=32768
AUDIT_OUTPUT_TOKENS=8192
MAX_OUTPUT_TOKENS=16384
LLM_CONCURRENCY=3
LLM_RETRIES=2
MAX_CONTINUATIONS=2
LLM_BACKOFF=1
LLM_MAX_DELAY=20
LLM_JITTER=0.2
REQUEST_TIMEOUT=120
MAX_SECONDS=600
MAX_CALLS=20
MAX_TOKENS=240000
WRITER_RESERVE_TOKENS=48000
WRITER_RESERVE_SECONDS=60
# USD account rates are required when MAX_COST_USD is enabled.
# ALIYUN_INPUT_PRICE_PER_MILLION=YOUR_USD_RATE
# ALIYUN_OUTPUT_PRICE_PER_MILLION=YOUR_USD_RATE
# ALIYUN_CACHED_PRICE_PER_MILLION=YOUR_USD_RATE
# ALIYUN_CACHE_WRITE_PRICE_PER_MILLION=YOUR_USD_RATE
# MAX_COST_USD=1

TAVILY_API_KEY=your-tavily-api-key
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_PRICE_PER_SEARCH=0.016
SEARCH_CONCURRENCY=5
SEARCH_RETRIES=3
SEARCH_BACKOFF=1
SEARCH_BACKOFF_MULTIPLIER=2
SEARCH_MAX_DELAY=15
SEARCH_JITTER=0.2
MAX_SEARCH_RETRIES=25
SEARCH_CIRCUIT_THRESHOLD=8
SEARCH_CIRCUIT_SECONDS=30
MAX_ROUNDS=2
MAX_SEARCHES=25
SESSION_DIR=reports/sessions
DATABASE_URL=postgresql://deepsearchagent@127.0.0.1:55432/deepsearchagent

# Evaluation uses the research model and shared recovery policy by default.
JUDGE_PROVIDER=research
JUDGE_OUTPUT_TOKENS=16384
JUDGE_INPUT_TOKENS=32000
JUDGE_TIMEOUT=60
JUDGE_RETRIES=1
READY_COVERAGE_THRESHOLD=0.90
# JUDGE_PROMPT_PATH=/absolute/path/to/custom-judge.md
# Optional separate PAI classifier (requires the PAI service and token):
# JUDGE_PROVIDER=pai
# JUDGE_MODEL_TOKEN=your-pai-judge-token
# JUDGE_MODEL=pai-judge
# JUDGE_BASE_URL=https://aiservice.cn-hangzhou.aliyuncs.com/v1
# JUDGE_JSON_MODE=json_object
# JUDGE_TEMPERATURE=0
# JUDGE_INPUT_PRICE_PER_MILLION=YOUR_USD_RATE
# JUDGE_OUTPUT_PRICE_PER_MILLION=YOUR_USD_RATE
# JUDGE_FALLBACK_PROVIDER=aliyun
# JUDGE_FALLBACK_MODEL=qwen-flash
# JUDGE_FALLBACK_BASE_URL=https://YOUR_VERIFIED_ENDPOINT/compatible-mode/v1
# JUDGE_FALLBACK_INPUT_PRICE_PER_MILLION=YOUR_USD_RATE
# JUDGE_FALLBACK_OUTPUT_PRICE_PER_MILLION=YOUR_USD_RATE

# Optional legacy Moonshot provider; never used as an implicit fallback.
# KIMI_API_KEY=your-kimi-api-key
# KIMI_MODEL=kimi-k3
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_REASONING_EFFORT=low
